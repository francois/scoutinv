<%= form_with(model: @instance, local: true, class: "forest-entity-form") do |form| %>
  <% if @instance.errors.any? %>
    <section class="forest-form-errors" aria-labelledby="instance-errors-heading" role="alert">
      <h2 id="instance-errors-heading"><%= pluralize(@instance.errors.count, "error") %> prohibited this instance from being saved:</h2>
      <ul>
        <% @instance.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="forest-form-section">
    <div class="grid-x grid-margin-x">
      <div class="small-12 large-8 cell">
        <p class="forest-filter-eyebrow"><%= @instance.product.name %></p>
        <h2><%= t(".details_heading") %></h2>
        <%= form.label :serial_no %>
        <%= form.text_field :serial_no, autocomplete: false, required: true %>

        <div class="forest-form-actions">
          <%= form.submit class: "button forest-button-primary" %>
          <%= link_to t(".cancel_button_label"), @instance.product, class: "button forest-button-secondary" %>
        </div>
      </div>
    </div>
  </section>
<% end %>
