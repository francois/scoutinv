<% if entity.kind_of?(Product) %>
  <%= render partial: "product_entity", locals: { product: entity } %>
<% else %>
  <% card_id = "consumable-card-title-#{entity.slug}" %>
  <div class="cell entity forest-product-card-cell" id="entity-card-<%= entity.slug %>">
    <article class="card forest-product-card forest-consumable-reservation-card <%= "is-unavailable" if entity.available_quantity.zero? %>" aria-labelledby="<%= card_id %>">
      <div class="forest-product-card__media">
        <%= forest_product_card_image entity %>
        <span class="forest-product-card__badge <%= "is-unavailable" if entity.available_quantity.zero? %>">
          <%= t("consumables.index.available_badge", quantity: format_quantity(entity.available_quantity)) %>
        </span>
      </div>

      <div class="card-section forest-product-card__body">
        <% if entity.categories.any? %>
          <p class="forest-product-card__categories">
            <%= entity.categories.map { |category| t(category.name, scope: "categories") }.join(" · ") %>
          </p>
        <% end %>

        <h3 class="forest-product-card__title" id="<%= card_id %>">
          <%= link_to entity.name, consumable_path(entity) %>
        </h3>

        <% if entity.description.present? %>
          <div class="forest-product-card__description" title="<%= entity.description %>">
            <%= simple_format entity.description %>
          </div>
        <% end %>

        <p class="forest-product-card__availability">
          <strong><%= format_quantity entity.available_quantity %></strong>
          <span><%= t("consumables.index.available_count") %></span>
        </p>

        <ul class="forest-product-card__stock-facts" aria-label="<%= t("consumables.index.stock_details") %>">
          <li><%= t("consumables.index.base_quantity", quantity: format_quantity(entity.base_quantity)) %></li>
          <% if entity.has_location? %>
            <li><%= format_product_location(entity, plain: true) %></li>
          <% end %>
        </ul>

        <p class="forest-product-card__price">
          <%= format_quantity(@event.quantity_of(entity), precision: 1) %>
          ×
          <%= number_to_currency @event.unit_price_of(entity) %> / <%= format_quantity entity.base_quantity %>
          =
          <strong><%= number_to_currency @event.subtotal_of(entity) %></strong>
        </p>
      </div>

      <% if @event.can_change_reservations?(current_member) %>
        <div class="forest-consumable-reservation-controls">
          <%= form_tag event_reservations_path(@event), remote: true, method: :post, class: "forest-consumable-reservation-form" do %>
            <%= hidden_field_tag "consume", "1" %>
            <%= text_field_tag "consumables[#{entity.slug}]", format_quantity(@event.quantity_of(entity), si_prefix: SI::BASE), class: "forest-consumable-quantity", autocomplete: false, aria: { label: t(".quantity_label") } %>
            <%= button_tag t(".set"), class: "button forest-button-primary", title: t(".set_hover") %>
          <% end %>
        </div>
      <% else %>
        <div class="forest-product-card__read-only">
          <%= format_quantity(@event.quantity_of(entity), precision: 1) %>
        </div>
      <% end %>
    </article>
  </div>
<% end %>
