<div id="product-card-<%= product.slug %>" class="cell forest-event-material-card-cell">
  <article class="card forest-event-material-card <%= "has-conflict" if @double_booked_products.include?(product) %>">
    <div class="forest-event-material-card__media">
      <%= entity_image product, height: 250 %>
      <% if @double_booked_products.include?(product) %>
        <span class="forest-event-material-card__badge" title="<%= t(".double_booked_hover") %>">!</span>
      <% end %>
    </div>
    <div class="card-section forest-event-material-card__body">
      <h4><%= link_to product.name, product_path(product) %></h4>
      <% if product.description.present? %>
        <div class="forest-event-material-card__description"><%= simple_format product.description %></div>
      <% end %>
      <% if product.has_location? %>
        <p class="forest-event-material-card__location"><%= format_product_location(product) %></p>
      <% end %>
      <p class="forest-event-material-card__quantity"><strong><%= number_with_delimiter @event.quantity_of(product) %></strong> <%= t("events.reservations.product_entity.item", count: @event.quantity_of(product)) %></p>
      <% if reservations.reject(&:free?).any? %>
        <p class="forest-event-material-card__price"><%= number_with_delimiter @event.quantity_of(product) %> × <%= number_to_currency @event.unit_price_of(product) %> = <strong><%= number_to_currency @event.subtotal_of(product) %></strong></p>
      <% end %>
    </div>
    <% if @event.can_change_reservations?(current_member) %>
      <div class="forest-event-material-card__stepper">
        <%= form_tag event_reservations_path(@event), remote: true, method: :post do %>
          <%= hidden_field_tag "products[#{product.slug}]", "1" %>
          <%= hidden_field_tag "back_to_event", "1" %>
          <%= hidden_field_tag "remove", "1" %>
          <%= button_tag t(".minus_one"), title: t(".minus_one_hover"), class: "button forest-event-material-card__remove", disabled: reservations.empty? %>
        <% end %>
        <%= form_tag event_reservations_path(@event), remote: true, method: :post do %>
          <%= hidden_field_tag "products[#{product.slug}]", "1" %>
          <%= hidden_field_tag "back_to_event", "1" %>
          <%= hidden_field_tag "add", "1" %>
          <%= button_tag t(".plus_one"), title: t(".plus_one_hover"), class: "button forest-event-material-card__add", disabled: product.available_quantity - product.reserved_quantity_on(@event.date_range) <= 0 %>
        <% end %>
      </div>
    <% end %>
  </article>
</div>
