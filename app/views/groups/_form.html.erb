<%= form_with(model: group, local: true, class: "forest-group-form") do |form| %>
  <% if group.errors.any? %>
    <section class="forest-form-errors" aria-labelledby="group-errors-heading" role="alert">
      <h2 id="group-errors-heading"><%= pluralize(group.errors.count, "error") %> prohibited this group from being saved:</h2>
      <ul>
        <% group.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <div class="forest-form-section">
    <div class="grid-x grid-margin-x">
      <div class="small-12 cell">
        <p class="forest-filter-eyebrow"><%= t("groups.form.details_heading", default: t("groups.new.page_title")) %></p>
        <h2><%= t("groups.form.details_heading", default: t("groups.new.page_title")) %></h2>
        <%= form.label :name %>
        <%= form.text_field :name, autocomplete: false %>
        <%= form.label :logo %>
        <%= form.file_field :logo, autocomplete: false %>
        <%= form.label :address %>
        <%= form.text_area :address, size: "80x5" %>
      </div>

      <div class="small-12 cell forest-form-actions">
        <%= form.submit class: "button forest-button-primary" %>
        <% if @group.new_record? %>
          <%= link_to t(".cancel_button_label"), groups_path, class: "button forest-button-secondary" %>
        <% else %>
          <%= link_to t(".cancel_button_label"), @group, class: "button forest-button-secondary" %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
