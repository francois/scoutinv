<%= form_with(model: member, local: true, class: "forest-member-form") do |form| %>
  <% if member.errors.any? %>
    <section class="forest-form-errors" aria-labelledby="member-errors-heading" role="alert">
      <h2 id="member-errors-heading"><%= pluralize(member.errors.count, "error") %> prohibited this member from being saved:</h2>
      <ul>
        <% member.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="forest-form-section">
    <div class="grid-x grid-margin-x">
      <div class="small-12 large-8 cell">
        <p class="forest-filter-eyebrow"><%= t("members.form.details_heading", default: t("members.edit.page_title", member_name: member.name)) %></p>
        <h2><%= t("members.form.details_heading", default: t("members.edit.page_title", member_name: member.name)) %></h2>
        <%= form.label :name %>
        <%= form.text_field :name, autocomplete: false %>
        <%= form.label :email %>
        <%= form.text_field :email, autocomplete: false %>

        <div class="forest-form-actions">
          <%= form.submit class: "button forest-button-primary" %>
          <%= link_to t(".cancel_button_label"), current_group, class: "button forest-button-secondary" %>
        </div>
      </div>
    </div>
  </section>
<% end %>
<% if current_member.inventory_director? %>
  <div class="forest-form-danger-zone">
    <%= button_to t(".delete_button_label"), member_path(@member), method: :delete, class: "button forest-button-danger" %>
    </div>
<% end %>
