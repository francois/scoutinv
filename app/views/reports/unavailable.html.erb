<section class="forest-report-panel" aria-labelledby="unavailable-report-heading">
  <p class="forest-filter-eyebrow"><%= t("reports.unavailable.page_title") %></p>
  <h2 id="unavailable-report-heading"><%= t("reports.unavailable.page_title") %></h2>
  <div class="forest-data-table-wrap">
    <table class="stack forest-data-table forest-report-table">
      <thead>
        <tr>
          <th><%= t(".product_header") %></th>
          <th><%= t(".serial_no_header") %></th>
          <th><%= t(".instance_state_header") %></th>
          <th><%= t(".last_returned_on_header") %></th>
        </tr>
      </thead>
      <tbody>
        <% if @report.rows.empty? %>
          <tr>
            <td colspan="4"><p class="forest-section-empty"><%= t(".no_unavailable_instances") %></p></td>
          </tr>
        <% else %>
          <% @report.rows.each do |row| %>
            <tr id="product-<%= row.product_slug %>-instance-<%= row.instance_slug %>">
              <td data-label="<%= t(".product_header") %>"><%= link_to row.product_name, product_path(id: row.product_slug) %></td>
              <td data-label="<%= t(".serial_no_header") %>" class="forest-report-serial"><%= format_serial_no(row.instance_serial_no) %></td>
              <td data-label="<%= t(".instance_state_header") %>"><span class="forest-instance-state is-<%= row.instance_state %>"><%= t row.instance_state, scope: "products.instance.states" %></span></td>
              <td data-label="<%= t(".last_returned_on_header") %>"><%= l row.last_returned_on.to_date, format: :with_year if row.last_returned_on %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
