<div class="grid-x grid-margin-x forest-product-show-layout">
  <div class="large-9 cell">
    <section class="forest-product-summary" aria-labelledby="product-summary-heading">
      <div class="grid-x grid-margin-x">
        <div class="small-12 medium-6 cell">
          <div class="grid-x grid-margin-x small-up-1 medium-up-2 forest-product-gallery">
            <% @product.images.select(&:blob).sort_by { |image| image.blob.filename.to_s.downcase }.each do |image| %>
              <%= render partial: "shared/image", locals: { entity: @product, image: image } %>
            <% end %>
            <% if @product.images.none?(&:blob) %>
              <div class="cell">
                <div class="forest-product-image-placeholder" aria-label="<%= t("products.card.no_photo") %>">
                  <span class="forest-product-card__image-initial" aria-hidden="true"><%= @product.name.first.to_s.upcase %></span>
                  <span><%= t("products.card.no_photo") %></span>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="small-12 medium-6 cell">
          <p class="forest-filter-eyebrow"><%= t(".stock_eyebrow") %></p>
          <h2 id="product-summary-heading"><%= t(".stock_heading") %></h2>

          <div class="forest-product-stock-total">
            <strong><%= number_with_delimiter @product.available_quantity %></strong>
            <span><%= t(".available_count", count: @product.available_quantity) %></span>
          </div>

          <dl class="forest-product-facts">
            <div>
              <dt><%= t("quantity", scope: "activerecord.attributes.product") %></dt>
              <dd><%= t(".total_count", count: @product.quantity) %></dd>
            </div>
            <div>
              <dt><%= t("location", scope: "activerecord.attributes.product") %></dt>
              <dd><%= @product.has_location? ? format_product_location(@product) : t(".no_location") %></dd>
            </div>
            <div>
              <dt><%= t("internal_unit_price", scope: "activerecord.attributes.product") %></dt>
              <dd><%= number_to_currency @product.internal_unit_price %></dd>
            </div>
            <div>
              <dt><%= t("external_unit_price", scope: "activerecord.attributes.product") %></dt>
              <dd><%= number_to_currency @product.external_unit_price %></dd>
            </div>
            <div class="forest-product-facts__wide">
              <dt><%= t("categories", scope: "products.form") %></dt>
              <dd><%= @product.categories.map { |category| t(category.name, scope: "categories") }.to_sentence.presence || t(".no_categories") %></dd>
            </div>
          </dl>
        </div>
      </div>

      <% if @product.description.present? %>
        <div class="forest-product-description">
          <p class="forest-filter-eyebrow"><%= t(".description_eyebrow") %></p>
          <h2><%= t("description", scope: "activerecord.attributes.product") %></h2>
          <%= simple_format @product.description %>
        </div>
      <% end %>
    </section>

    <section class="forest-product-section" aria-labelledby="product-instances-heading">
      <p class="forest-filter-eyebrow"><%= t(".instances_eyebrow") %></p>
      <h2 id="product-instances-heading"><%= t(".instance_serial_nos_header") %></h2>
      <div class="forest-data-table-wrap">
        <table class="stack forest-data-table forest-instances-table">
          <thead>
            <tr>
              <th><%= t(".serial_no_header") %></th>
              <th><%= t(".state_header") %></th>
              <th><span class="show-for-sr"><%= t(".actions_header") %></span></th>
            </tr>
          </thead>
          <tbody>
            <% @product.instances.sort_by { |instance| [instance.state, instance.serial_no] }.each do |instance| %>
              <%= render partial: "instance", locals: { instance: instance } %>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="forest-product-section" aria-labelledby="product-history-heading">
      <p class="forest-filter-eyebrow"><%= t(".history_eyebrow") %></p>
      <h2 id="product-history-heading"><%= t(".product_reservation_history_header") %></h2>
      <% if @product.reservations.any? %>
        <div class="forest-data-table-wrap">
          <table class="stack forest-data-table">
            <thead>
              <tr>
                <th><%= t(".serial_no_header") %></th>
                <th><%= t(".dates_header") %></th>
                <th><%= t(".event_header") %></th>
              </tr>
            </thead>
            <tbody>
              <% @product.reservations.sort_by { |reservation| [reservation.serial_no, reservation.start_on] }.reverse.each do |reservation| %>
                <tr>
                  <td data-label="<%= t(".serial_no_header") %>"><span class="forest-product-card__serial"><%= format_serial_no(reservation.serial_no) %></span></td>
                  <td data-label="<%= t(".dates_header") %>"><%= format_date_range(reservation.real_date_range) %></td>
                  <td data-label="<%= t(".event_header") %>"><%= link_to reservation.title, event_reservations_path(reservation.event) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="forest-section-empty"><%= t(".no_reservations") %></p>
      <% end %>
    </section>
  </div>

  <aside class="large-3 cell forest-product-actions-column">
    <div class="forest-product-actions">
      <% if @event %>
        <section class="forest-product-event-action" aria-labelledby="product-event-heading">
          <p class="forest-filter-eyebrow"><%= t(".event_eyebrow") %></p>
          <h2 id="product-event-heading"><%= @event.title %></h2>
          <p><%= format_date_range(@event.real_date_range) %></p>
          <%= form_tag event_reservations_path(@event) do %>
            <%= hidden_field_tag "products[#{@product.slug}]", "1" %>
            <%= submit_tag t(".add_to_cart_label"), name: :add, class: "button expanded forest-button-primary" %>
          <% end %>
        </section>
      <% end %>

      <% if current_member.inventory_director? %>
        <%= link_to t(".edit_button_label"), edit_product_path(@product), class: "button expanded forest-button-primary" %>
        <%= link_to t(".clone_button_label"), new_product_path(clone_from: @product), class: "button expanded forest-button-secondary" %>
      <% end %>
      <%= link_to t(".back_to_list_button_label"), products_path, class: "button expanded forest-button-secondary" %>

      <% if current_member.inventory_director? %>
        <section class="forest-product-danger-zone" aria-labelledby="product-danger-heading">
          <p class="forest-filter-eyebrow"><%= t(".danger_eyebrow") %></p>
          <h2 id="product-danger-heading"><%= t(".danger_heading") %></h2>
          <%= link_to t(".convert_to_consumable_label"),
                      convert_product_path(@product),
                      method: :post,
                      data: { confirm: t(".convert_confirm") },
                      class: "button expanded forest-button-warning" %>
          <%= link_to t(".delete_button_label"),
                      product_path(@product),
                      method: :delete,
                      data: { confirm: t(".delete_confirm") },
                      class: "button expanded forest-button-danger" %>
        </section>
      <% end %>

      <section class="forest-product-notes">
        <%= render partial: "shared/notes", locals: { parent: @product, note: @note, create_note_path: product_notes_path(@product) } %>
      </section>
    </div>
  </aside>
</div>
