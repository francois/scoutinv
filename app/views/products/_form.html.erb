<%= form_with(model: product, local: true, class: "forest-product-form") do |form| %>
  <%= hidden_field_tag :clone_from, @clone_from&.to_param %>

  <% if product.errors.any? %>
    <section class="forest-form-errors" aria-labelledby="product-errors-heading" role="alert">
      <h2 id="product-errors-heading"><%= t(".error_heading", count: product.errors.count) %></h2>
      <ul>
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <div class="grid-x grid-margin-x">
    <div class="small-12 large-8 cell">
      <section class="forest-form-section" aria-labelledby="product-details-heading">
        <p class="forest-filter-eyebrow"><%= t(".details_eyebrow") %></p>
        <h2 id="product-details-heading"><%= t(".details_heading") %></h2>

        <%= form.label :name %>
        <%= form.text_field :name, autocomplete: false %>

        <%= form.label :description %>
        <%= form.text_area :description, rows: 5 %>
      </section>

      <section class="forest-form-section" aria-labelledby="product-photos-heading">
        <p class="forest-filter-eyebrow"><%= t(".photos_eyebrow") %></p>
        <h2 id="product-photos-heading"><%= t(".photos_heading") %></h2>

        <%= form.label :images %>
        <%= form.file_field :images, multiple: true, aria: { describedby: "help-on-images" }, autocomplete: false %>
        <p id="help-on-images" class="forest-form-help"><%= t(".help_on_images") %></p>

        <%= form.label :image_url %>
        <%= form.text_field :image_url, aria: { describedby: "help-on-image-url" }, autocomplete: false %>
        <p id="help-on-image-url" class="forest-form-help"><%= t(".help_on_image_url") %></p>
      </section>

      <section class="forest-form-section" aria-labelledby="product-location-heading">
        <p class="forest-filter-eyebrow"><%= t(".location_eyebrow") %></p>
        <h2 id="product-location-heading"><%= t(".location_label") %></h2>

        <div class="grid-x grid-margin-x small-up-1 medium-up-2">
          <div class="cell">
            <%= form.label :building %>
            <%= form.text_field :building %>
          </div>
          <div class="cell">
            <%= form.label :aisle %>
            <%= form.text_field :aisle %>
          </div>
          <div class="cell">
            <%= form.label :shelf %>
            <%= form.text_field :shelf %>
          </div>
          <div class="cell">
            <%= form.label :unit %>
            <%= form.text_field :unit %>
          </div>
        </div>
      </section>

      <section class="forest-form-section" aria-labelledby="product-stock-heading">
        <p class="forest-filter-eyebrow"><%= t(".stock_eyebrow") %></p>
        <h2 id="product-stock-heading"><%= t(".stock_heading") %></h2>

        <div class="grid-x grid-margin-x small-up-1 medium-up-3">
          <div class="cell">
            <%= form.label :quantity %>
            <%= form.number_field :quantity, min: 1, step: 1 %>
          </div>
          <div class="cell">
            <%= form.label :internal_unit_price %>
            <%= form.number_field :internal_unit_price, min: 0, step: BigDecimal("0.01") %>
          </div>
          <div class="cell">
            <%= form.label :external_unit_price %>
            <%= form.number_field :external_unit_price, min: 0, step: BigDecimal("0.01") %>
          </div>
        </div>
      </section>

      <section class="forest-form-section" aria-labelledby="product-categories-heading">
        <p class="forest-filter-eyebrow"><%= t(".categories_eyebrow") %></p>
        <h2 id="product-categories-heading"><%= t(".categories_label") %></h2>

        <div class="grid-x grid-margin-x small-up-1 medium-up-2">
          <%= form.collection_check_boxes :category_slugs, @categories, :slug, ->(category) { t(category.name, scope: "categories") } do |box| %>
            <div class="cell forest-form-check-option">
              <%= box.check_box(class: "forest-form-checkbox") %>
              <%= box.label(class: "forest-form-check-label") %>
            </div>
          <% end %>
        </div>
      </section>

      <div class="forest-form-actions">
        <%= form.submit class: "button forest-button-primary" %>
        <% cancel_path = product.new_record? ? products_path : product_path(product) %>
        <%= link_to t(".cancel_button_label"), cancel_path, class: "button forest-button-secondary" %>
      </div>
    </div>
  </div>
<% end %>
