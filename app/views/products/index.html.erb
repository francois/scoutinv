<div class="grid-x grid-margin-x forest-products-layout">
  <aside class="large-3 medium-4 cell show-for-medium forest-filter-sidebar-column" aria-label="<%= t(".filters_title") %>">
    <div class="forest-filter-sidebar">
      <%= link_to t(".new_product_button_label"), new_product_path, class: "button expanded forest-filter-submit forest-products-new-button" if current_member.inventory_director? %>
      <%= render partial: "filters", locals: { id_prefix: "desktop" } %>
    </div>
  </aside>

  <div class="large-9 medium-8 small-12 cell">
    <div class="hide-for-medium forest-products-mobile-controls">
      <%= link_to t(".new_product_button_label"), new_product_path, class: "button expanded forest-filter-submit forest-products-new-button" if current_member.inventory_director? %>

      <details class="forest-mobile-filters" <%= "open" if @has_active_filters %>>
        <summary>
          <span><%= t(".filters_title") %></span>
          <% if @has_active_filters %>
            <span class="forest-mobile-filters__count"><%= t(".active_filters") %></span>
          <% end %>
        </summary>
        <div class="forest-mobile-filters__body">
          <%= render partial: "filters", locals: { id_prefix: "mobile" } %>
        </div>
      </details>
    </div>

    <% if @products.any? %>
      <div class="grid-x grid-margin-x small-up-1 medium-up-2 large-up-3">
        <% @products.each do |product| %>
          <%= render partial: "product_card", locals: { product: product } %>
        <% end %>
      </div>
      <div class="forest-products-pagination">
        <%= paginate @products %>
      </div>
    <% else %>
      <section class="forest-empty-state" aria-labelledby="products-empty-heading">
        <p class="forest-filter-eyebrow"><%= t(".filters_title") %></p>
        <h2 id="products-empty-heading"><%= t(".empty_title") %></h2>
        <p><%= t(".sorry_no_elements") %></p>
        <%= link_to t(".view_all_button_label"), products_path, class: "button forest-pagination-button" if @has_active_filters %>
      </section>
    <% end %>
  </div>
</div>
