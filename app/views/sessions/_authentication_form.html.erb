<%= form_tag sessions_path, method: :post, class: "forest-authentication-form" do %>
  <div class="grid-x grid-margin-x">
      <div class="small-12 cell forest-authentication-form__field">
        <%= label_tag :email, t(".email") %>
        <%= email_field_tag :email, "", placeholder: t(".email_placeholder"), required: true %>
      </div>

      <div class="small-12 cell forest-form-actions">
        <%= submit_tag t(".send_authentication_email_button_label"), class: "button forest-button-primary" %>
      </div>
  </div>
<% end %>
